# 나비엔 스마트 계정
NAVIEN_USERNAME=your_id
NAVIEN_PASSWORD=your_password

# Hubitat 쪽 MQTT 브로커
# - Hubitat 내장 브로커를 쓰면: 허브 IP, 그리고 내장 MQTT 서비스 활성화 시 표시되는 포트/계정
# - 별도 Mosquitto 등 외부 브로커를 쓰면 그 정보
MQTT_HOST=192.168.x.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Hubitat 드라이버와 맞춰야 하는 토픽 프리픽스 (기본값 그대로 두면 됨)
MQTT_PREFIX=navien

LOG_LEVEL=INFO
